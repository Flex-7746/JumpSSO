#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# node 目录
export PATH=/var/apps/nodejs_v22/target/bin:$PATH

# 用户输入
SSO_SERVER="$wizard_sso_server"
SSO_PORT="$wizard_sso_port"
SSO_REDIS="$wizard_sso_redis"
SSO_MYSQL="$wizard_sso_mysql"

# 执行命令
RUN="NODE_ENV=production node src/app.js --server=${SSO_SERVER} --port=${SSO_PORT} --redis=${SSO_REDIS} --mysql=${SSO_MYSQL}"
CMD="cd ${TRIM_APPDEST}/server && ${RUN}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ..."
    
    # 打印执行的命令到日志
    log_msg "Executing command: ${CMD}"

    # run the nodejs process
    bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &

    # write pid to pidfile
    printf "%s" "$!" > ${PID_FILE}

    # 打印 PID 信息到日志
    log_msg "Process started with PID: $!, PID saved to: ${PID_FILE}"

    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        log_msg "pid=${pid}"
        
        # 检查进程是否存在
        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}" >> ${LOG_FILE} 2>&1
            
            # 等待一小会儿确认进程被杀死
            sleep 1
            
            if ! check_process "${pid}"; then
                log_msg "process killed successfully"
            else
                log_msg "WARNING: process still running after KILL signal"
            fi
        else
            log_msg "process not exist"
        fi
        
        # 无论进程是否存在，都删除 PID 文件
        rm -f "${PID_FILE}"
        log_msg "pid file removed"
    else
        log_msg "PID file not found or not readable"
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac